e"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"allowit_kernel","contents":"#![no_std]\npub mod policy;\npub mod policy_api;\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"src/policy.rs"},"crate_name":"allowit_kernel","contents":"//! Native policy source, copied byte-for-byte into both chain builds.\n//! Amounts use six-decimal policy units. Only daily_limit is explicitly tunable.\nuse crate::policy_api::{Context, PolicyError};\n\npub const MAX_DAILY_LIMIT: u64 = 50_000_000;\npub const DAY_SECONDS: u64 = 86_400;\n\npub fn validate_daily_limit(value: u64) -> Result<(), PolicyError> {\n    if value > MAX_DAILY_LIMIT {\n        return Err(PolicyError::ParameterOutOfBounds);\n    }\n    Ok(())\n}\n\npub fn evaluate(ctx: &Context) -> Result<u64, PolicyError> {\n    if !ctx.approved {\n        return Err(PolicyError::NotApproved);\n    }\n    if ctx.amount == 0 {\n        return Err(PolicyError::ZeroAmount);\n    }\n    validate_daily_limit(ctx.daily_limit)?;\n    let day = ctx.now / DAY_SECONDS;\n    if day < ctx.spent_day {\n        return Err(PolicyError::ClockWentBackwards);\n    }\n    let spent = if day == ctx.spent_day { ctx.spent } else { 0 };\n    let next = spent.checked_add(ctx.amount).ok_or(PolicyError::Overflow)?;\n    if next > ctx.daily_limit {\n        return Err(PolicyError::DailyLimitExceeded);\n    }\n    Ok(next)\n}\n"},{"id":12,"name":{"Local":"src/policy_api.rs"},"crate_name":"allowit_kernel","contents":"#[cfg_attr(feature = \"stellar\", soroban_sdk::contracttype)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct Context {\n    pub approved: bool,\n    pub amount: u64,\n    pub daily_limit: u64,\n    pub spent: u64,\n    pub spent_day: u64,\n    pub now: u64,\n}\n\n#[cfg_attr(feature = \"stellar\", soroban_sdk::contracterror)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[repr(u32)]\npub enum PolicyError {\n    NotApproved = 1,\n    ZeroAmount = 2,\n    ParameterOutOfBounds = 3,\n    ClockWentBackwards = 4,\n    Overflow = 5,\n    DailyLimitExceeded = 6,\n}\n"},{"id":13,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","c