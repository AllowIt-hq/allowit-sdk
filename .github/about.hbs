<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>allowit_sdk.wasm dependency licenses</title>
</head>
<body>
<h1>allowit_sdk.wasm dependency licenses</h1>
<p>Allowit-authored code is released under the MIT License in LICENSE. The crates below keep their own terms.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
